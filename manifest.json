{
  "manifest_version": 3,
  "name": "Team Wallet Labels",
  "version": "1.0.0",
  "description": "Replace DEXTools maker addresses with labels from your team wallet list.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "notifications"],
  "host_permissions": ["*://*.dextools.io/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Team Wallet Labels",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.dextools.io/*"],
      "js": ["page.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.dextools.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
